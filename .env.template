# Server-Side Tagging Configuration
# ⚠️ WARNING: Never commit actual secret keys to version control. Copy this file to .env and fill in the values.

# 1. Google Tag Manager (Web Container)
# Client-safe variable (prefixed with PUBLIC_ to expose to client)
PUBLIC_GTM_ID=GTM-XXXXXXX

# 2. Server-side GTM (sGTM) Endpoint
# All analytics hits/CAPI calls will route through this subdomain endpoint
SGTM_URL=https://gtm.lumaguard.com/data

# 3. Direct Platform Fallbacks (Used if SGTM_URL is empty)
META_PIXEL_ID=
META_CAPI_TOKEN=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# 4. Testing (Set only in dev environment, do not push to production)
# META_TEST_EVENT_CODE=TEST_CODE
