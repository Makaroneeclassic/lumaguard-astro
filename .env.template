# ⚠️ อย่า commit ค่าจริงลง version control — คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า

# ─────────────────────────────────────────────
# 1. Database (Supabase Postgres)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ─────────────────────────────────────────────
# 2. Admin authentication (บังคับ)
# ─────────────────────────────────────────────
# ใช้เซ็นคุกกี้ session ของ /admin ต้องยาวอย่างน้อย 32 ตัวอักษร
# สร้างด้วย: openssl rand -base64 32
AUTH_SECRET=

# ─────────────────────────────────────────────
# 3. Rate limiting (ไม่บังคับ — ถ้าไม่ตั้งจะใช้ in-memory แทน)
# ─────────────────────────────────────────────
# บน Vercel แต่ละ instance มีหน่วยความจำแยกกัน ตัว in-memory จึงกันได้ไม่ทั่วถึง
# ควรตั้ง Upstash บน production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────
# 4. Google Tag Manager
# ─────────────────────────────────────────────
PUBLIC_GTM_ID=GTM-XXXXXXX

# Server-side GTM endpoint — analytics/CAPI ทั้งหมดวิ่งผ่านทางนี้
SGTM_URL=https://gtm.lumaguardthailand.com/data

# ใช้เมื่อ SGTM_URL ว่าง
META_PIXEL_ID=
META_CAPI_TOKEN=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# ─────────────────────────────────────────────
# 5. แจ้งเตือนลีด (ยังไม่ได้ต่อ — ดู Phase 5 ในแผน)
# ─────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=

# ─────────────────────────────────────────────
# 6. Testing (dev เท่านั้น)
# ─────────────────────────────────────────────
# META_TEST_EVENT_CODE=TEST_CODE

# ─────────────────────────────────────────────
# 7. Google Sheet สำหรับบทความ (ใช้กับ npm run blog:sync)
# ─────────────────────────────────────────────
# เอา ID จาก URL ของชีต: docs.google.com/spreadsheets/d/<ID>/edit
# ชีตต้องเปิดสิทธิ์ "ผู้ที่มีลิงก์ดูได้" มิฉะนั้นสคริปต์ดึงข้อมูลไม่ได้
BLOG_SHEET_ID=
BLOG_SHEET_TAB=blog

# ─────────────────────────────────────────────
# 8. ยืนยันสิทธิ์ Search Console (ทางสำรอง)
# ─────────────────────────────────────────────
# แนะนำให้ยืนยันด้วยระเบียน TXT ที่ DNS แทน เพราะไม่เพิ่มน้ำหนักหน้าเว็บ
# และครอบคลุมทุกซับโดเมน ใส่ตรงนี้เฉพาะกรณีแก้ DNS ไม่ได้
GOOGLE_SITE_VERIFICATION=
