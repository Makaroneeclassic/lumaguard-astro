// Prisma 7 ไม่รับ url ในไฟล์ schema แล้ว — connection URL ของฝั่ง CLI
// ย้ายไปอยู่ที่ prisma.config.ts ส่วนตอน runtime แอปต่อผ่าน driver adapter
// ใน src/lib/db.ts ซึ่งอ่าน DATABASE_URL เอง
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model SeoGlobal {
  id                     String   @id @default("global")
  siteName               String   @default("LUMAGUARD")
  titleTemplate          String   @default("%s | LUMAGUARD")
  defaultDescription     String   @db.Text
  defaultOgImage         String?  @db.Text
  googleVerificationCode String?
  googleAnalyticsId      String?
  robotsTxtDirectives    String?  @db.Text
  primaryColor           String   @default("#0f172a")
  secondaryColor         String   @default("#0284c7")
  textColor              String   @default("#1e293b")
  buttonColor            String   @default("#0f172a")
  buttonTextColor        String   @default("#ffffff")
  fontFamily             String   @default("Noto Sans Thai")
  businessAddress        String?  @db.Text
  businessPhone          String?
  businessPriceRange     String?
  businessMapUri         String?  @db.Text
  updatedAt              DateTime @updatedAt
}

model SeoPage {
  id            String   @id @default(uuid())
  routePath     String   @unique
  pageName      String
  title         String   @db.Text
  description   String   @db.Text
  keywords      String?  @db.Text
  canonicalUrl  String?  @db.Text
  ogTitle       String?  @db.Text
  ogDescription String?  @db.Text
  ogImage       String?  @db.Text
  noindex       Boolean  @default(false)
  nofollow      Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

// หมายเหตุ: model BlogPost ถูกถอดออกแล้ว บทความย้ายไปเก็บเป็น MDX ใน git
// ที่ src/content/blog/ เพื่อให้มี version history, บังคับกติกา SEO ตอน build
// และฝัง component ในบทความได้ ดู src/content.config.ts และ src/lib/blog.ts

model Lead {
  id           String   @id @default(uuid())
  name         String
  phone        String

  /// building = งานอาคาร/บ้าน · car = งานฟิล์มรถยนต์
  /// ค่าเริ่มต้นเป็น building เพื่อให้ลีดเก่าที่เก็บไว้ก่อนมีงานรถยังอ่านได้ถูก
  leadType     String   @default("building")

  /// สองช่องนี้เคยบังคับ เพราะตอนนั้นมีแต่งานอาคาร
  /// งานรถไม่มีทั้งเขตพื้นที่และประเภทอาคาร จึงต้องยอมให้ว่างได้
  district     String?
  propertyType String?
  areaSize     Float?

  /// เฉพาะงานรถ — ทีมขายต้องรู้ยี่ห้อกับรุ่นก่อนเสนอราคา
  /// เพราะราคาคิดตามขนาดรถ ไม่ใช่ตามพื้นที่กระจก
  carBrand     String?
  carModel     String?
  status          String   @default("new")
  estimatedArea   Float?
  recommendedFilm String?
  trafficSource   String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  gclid           String?
  landingPage     String?  @db.Text
  createdAt       DateTime @default(now())
}




