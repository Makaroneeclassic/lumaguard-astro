---
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import { buildSiteSchema } from '@/lib/schema';
import ConsentBanner from '@/components/ConsentBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  schema?: Record<string, any>;
}

const { title, description, image, type, publishedTime, modifiedTime, noindex, schema } = Astro.props;
const gtmId = import.meta.env.PUBLIC_GTM_ID || '';

// ถ้ายังไม่ได้ตั้ง GTM แต่มี GA4 ก็โหลด gtag.js ตรงแทน
// จะได้เริ่มเก็บข้อมูลได้โดยไม่ต้องรอสร้าง container ให้เสร็จก่อน
// ถ้าตั้ง GTM แล้ว ให้ GA4 ไปอยู่ในนั้นแทน จะได้ไม่โหลดสคริปต์ซ้ำสองตัว
const ga4Id = !gtmId ? (import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || '') : '';

// วิธียืนยันสิทธิ์ที่ดีกว่าคือใส่ระเบียน TXT ที่ DNS ซึ่งไม่เพิ่มน้ำหนักหน้าเว็บ
// และครอบคลุมทุกซับโดเมน ตัวนี้เป็นทางสำรองสำหรับกรณีที่แก้ DNS ไม่ได้
const googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION || '';
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#004692" />
    {googleVerification && (
      <meta name="google-site-verification" content={googleVerification} />
    )}
    
    {/*
      ฟอนต์โฮสต์เองแล้ว ประกาศ @font-face อยู่ใน global.css
      preload เพื่อให้เริ่มโหลดพร้อมกับ CSS ไม่ต้องรอให้ CSS ถูกแยกวิเคราะห์ก่อน

      ต้อง preload ทั้งสอง subset เพราะทุกหน้ามีทั้งสองชุดอักษรอยู่เหนือเส้นพับ
      ไทยคือเนื้อหาเกือบทั้งหน้า ส่วนละตินคือชื่อแบรนด์บนแถบเมนูและพาดหัวหลัก
      เดิม preload แค่ชุดไทย ชุดละตินจึงเริ่มโหลดช้ากว่าและทำให้พาดหัวกระพริบ
      เปลี่ยนฟอนต์ให้เห็น เพราะ @font-face ตั้ง font-display เป็น swap ไว้

      subset ext ไม่ preload เพราะมีแค่อักขระพิเศษที่แทบไม่ถูกใช้จริง
    */}
    <link
      rel="preload"
      href="/fonts/noto-sans-thai-thai.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/noto-sans-thai-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    
    <SEO 
      title={title} 
      description={description} 
      image={image} 
      type={type} 
      publishedTime={publishedTime} 
      modifiedTime={modifiedTime} 
      noindex={noindex} 
    />
    
    {/* Organization + WebSite + LocalBusiness ผูกกันด้วย @id ใส่ทุกหน้า */}
    <JsonLd schema={buildSiteSchema()} />
    {schema && <JsonLd schema={schema} />}
    
    {/* Consent Mode v2 Default Settings */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'wait_for_update': 500
      });
    </script>
    
    {/*
      โหลด GA4 ตรงเมื่อยังไม่มี GTM รอจนเบราว์เซอร์ว่างเช่นเดียวกัน
      Consent Mode ด้านบนทำงานไปแล้ว gtag จึงเคารพสถานะความยินยอมตั้งแต่ต้น
    */}
    {ga4Id && (
      <script is:inline define:vars={{ ga4Id }}>
        (function (w, d) {
          function loadGa4() {
            var s = d.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
            d.head.appendChild(s);
            w.dataLayer = w.dataLayer || [];
            function gtag() { w.dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', ga4Id);
          }
          if ('requestIdleCallback' in w) {
            w.requestIdleCallback(loadGa4, { timeout: 3000 });
          } else {
            w.addEventListener('load', function () { setTimeout(loadGa4, 1200); });
          }
        })(window, document);
      </script>
    )}

    {/*
      โหลด GTM ตอนเบราว์เซอร์ว่าง ไม่ใช่ทันทีที่เจอแท็ก
      
      สคริปต์ GTM มักเป็นไฟล์ที่หนักที่สุดในหน้าการตลาด การปล่อยให้ดึงพร้อม
      กับเนื้อหาทำให้แย่งแบนด์วิดท์และเวลาประมวลผลช่วงที่กำลังวาดหน้าจอ
      requestIdleCallback จึงเลื่อนไปทำตอนงานหลักเสร็จแล้ว โดยมี setTimeout
      สำรองไว้สำหรับเบราว์เซอร์ที่ยังไม่รองรับ
      
      ส่วน Consent Mode ด้านบนยังทำงานทันทีตามเดิม เพราะต้องตั้งค่าความยินยอม
      ให้เสร็จก่อน GTM เริ่มทำงานเสมอ
    */}
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function (w, d, s, l, i) {
          function loadGtm() {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          }
          if ('requestIdleCallback' in w) {
            w.requestIdleCallback(loadGtm, { timeout: 3000 });
          } else {
            w.addEventListener('load', function () { setTimeout(loadGtm, 1200); });
          }
        })(window, document, 'script', 'dataLayer', gtmId);
      </script>
    )}
  </head>
  <body class="bg-surface text-on-surface font-body selection:bg-primary-fixed selection:text-on-primary-fixed">
    {/* Google Tag Manager (noscript) */}
    {gtmId && (
      <noscript>
        <iframe 
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0" 
          width="0" 
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    
    <ConsentBanner />

    <div class="min-h-screen flex flex-col justify-between">
      <main class="flex-grow">
        <slot />
      </main>
    </div>
  </body>
</html>
