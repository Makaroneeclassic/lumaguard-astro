---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}
const { title, description, image = '/og-default.jpg', type = 'website',
        publishedTime, modifiedTime, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{/*
  ใช้ follow ไม่ใช่ nofollow

  noindex บอกว่าอย่าเอาหน้านี้เข้าผลค้นหา ส่วน nofollow บอกว่าอย่าเดินตามลิงก์
  ในหน้านี้เลย ซึ่งเป็นคนละเรื่องกัน หน้าที่ซ่อนชั่วคราวยังมีลิงก์ไปหน้าขายและ
  บทความอื่นอยู่ การใส่ nofollow ทำให้ลิงก์เหล่านั้นไม่ส่งน้ำหนักต่อไปไหนเลย
  ทั้งที่เราแค่ไม่อยากให้ตัวหน้านี้ติดอันดับ
*/}
{noindex && <meta name="robots" content="noindex,follow" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="th_TH" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
