---
interface Props {
  faq: ReadonlyArray<{ q: string; a: string }>;
  heading?: string;
}

const { faq, heading = 'คำถามที่พบบ่อย' } = Astro.props;
---

{
  faq.length > 0 && (
    <section class="not-prose my-10 space-y-4">
      <h2 class="text-2xl font-bold text-slate-900">{heading}</h2>
      <div class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
        {faq.map((item) => (
          <details class="group p-5 open:bg-slate-50/60">
            <summary class="cursor-pointer list-none font-semibold text-slate-900 marker:hidden flex items-start justify-between gap-4">
              <span>{item.q}</span>
              <span
                aria-hidden="true"
                class="mt-1 shrink-0 text-slate-600 transition-transform group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-3 leading-relaxed text-slate-600">{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
