---
import Layout from '../../layouts/Layout.astro';
import TopNavBar from '@/components/TopNavBar.astro';
import Footer from '@/components/Footer';
import PriceEstimator from '@/components/PriceEstimator';
import LeadForm from '@/components/LeadForm';

import { getEstimatorRates } from '@/lib/rates';
const processSteps = [
  {
    stepNo: "01",
    title: "ปรึกษาและประเมินหน้างานฟรี",
    description: "ทีมงานรับฟังความต้องการของคุณ ทั้งเรื่องทิศทางแดด ความเป็นส่วนตัว งบประมาณ และปัญหาความร้อนที่เจอ จากนั้นเข้าวัดพื้นที่กระจกจริงถึงบ้าน เพื่อประเมินราคาที่แม่นยำ — บริการนี้ฟรี ไม่มีค่าใช้จ่าย"
  },
  {
    stepNo: "02",
    title: "เลือกฟิล์มที่เหมาะกับบ้านคุณ",
    description: "ช่างผู้เชี่ยวชาญแนะนำฟิล์มที่เหมาะกับการใช้งานจริง ไม่ว่าจะเป็นฟิล์มเซรามิคที่เน้นความใสกันร้อน ฟิล์มปรอทที่ข้างนอกมองไม่เห็น หรือฟิล์มนิรภัยเพื่อความปลอดภัย พร้อมใบเสนอราคาชัดเจนก่อนเริ่มงาน"
  },
  {
    stepNo: "03",
    title: "ติดตั้งโดยช่างมืออาชีพ",
    description: "ทีมช่างติดฟิล์มกระจกบ้านที่มากประสบการณ์ลงมือติดตั้งอย่างพิถีพิถัน ทำความสะอาดกระจก ติดฟิล์มให้เรียบเนียน ไร้ฟองอากาศ ไร้ฝุ่น พร้อมดูแลความสะอาดพื้นที่หน้างานตลอดการทำงาน"
  },
  {
    stepNo: "04",
    title: "ตรวจรับงานและรับประกัน",
    description: "ตรวจสอบคุณภาพงานติดตั้งร่วมกันจนคุณพอใจ พร้อมมอบการรับประกันทั้งตัวฟิล์มและงานติดตั้ง หากมีปัญหาหลังการใช้งาน ทีมงานพร้อมดูแลคุณต่อเนื่อง"
  }
];

const title = "บริการติดตั้งฟิล์มกรองแสง ขั้นตอนงานติดตั้ง | LUMAGUARD";
const description =
  "ขั้นตอนการติดตั้งฟิล์มกรองแสงอาคารโดยทีมช่างมืออาชีพ ตั้งแต่สำรวจหน้างาน วัดขนาดกระจก ติดตั้งในพื้นที่ควบคุมฝุ่น พร้อมรับประกันคุณภาพงานติดตั้ง";

const estimatorRates = await getEstimatorRates();
---

<Layout title={title} description={description}>
  <TopNavBar pathname={Astro.url.pathname} />

  <main class="min-h-screen pt-24 pb-16 px-6 max-w-[1440px] mx-auto space-y-16">
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h1 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight">
        ขั้นตอนการบริการมาตรฐานสากล
      </h1>
      <p class="text-slate-600 text-base leading-relaxed">
        ความพิถีพิถันใส่ใจทุกขั้นตอน ตั้งแต่วัดหน้างาน ประเมินราคา ช่างผู้เชี่ยวชาญ และบริการหลังการขาย
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {processSteps.map((step) => (
        <div key={step.stepNo} class="space-y-4 text-center md:text-left flex flex-col items-center md:items-start">
          <div class="w-16 h-12 rounded-2xl bg-slate-100 flex items-center justify-center shadow-inner">
            <span class="text-slate-800 font-extrabold text-xl">{step.stepNo}</span>
          </div>
          <h2 class="text-lg font-bold text-slate-900">{step.title}</h2>
          <p class="text-slate-600 text-sm leading-relaxed font-light">
            {step.description}
          </p>
        </div>
      ))}
    </div>

    <PriceEstimator client:visible rates={estimatorRates} />

    <section id="contact" class="py-12">
      <LeadForm client:visible />
    </section>
  </main>

  <Footer client:visible />
</Layout>
