---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'ขอบคุณที่ติดต่อเรา | Luma Guard';
const pageDescription = 'เราได้รับข้อมูลการขอประเมินราคาฟิล์มของท่านเรียบร้อยแล้ว ทีมงานผู้เชี่ยวชาญจะติดต่อกลับเพื่อประเมินราคาโดยเร็วที่สุด';
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <section class="min-h-[70vh] flex items-center justify-center py-24 px-6 relative overflow-hidden">
    <div class="absolute inset-0 bg-radial-gradient from-sky-950/10 to-brand-dark/95 z-10"></div>
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-sky-500/10 rounded-full blur-[120px]"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-emerald-500/10 rounded-full blur-[120px]"></div>

    <div class="max-w-md w-full glass-card rounded-2xl p-8 border border-white/10 text-center relative z-20 space-y-6 shadow-2xl">
      <div class="w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto text-3xl font-bold border border-emerald-500/30">
        ✓
      </div>
      
      <div class="space-y-2">
        <h1 class="text-3xl font-black text-white tracking-tight">ขอบคุณค่ะ/ครับ</h1>
        <p class="text-slate-300 text-sm">
          ทางทีมงาน Luma Guard ได้รับข้อมูลของคุณเรียบร้อยแล้ว เจ้าหน้าที่ผู้เชี่ยวชาญจะทำการประเมินราคาและติดต่อกลับหาคุณโดยด่วนที่สุดภายใน 24 ชั่วโมง
        </p>
      </div>

      <div class="pt-4 border-t border-white/5 space-y-4">
        <div class="bg-[#080d16] rounded-xl p-3 text-left">
          <span class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest">Lead Reference ID</span>
          <code id="leadRefId" class="text-xs text-sky-400 font-mono break-all select-all">กำลังโหลดรหัสอ้างอิง...</code>
        </div>
        
        <a href="/" class="btn-premium w-full py-2.5 text-xs flex items-center justify-center">
          กลับไปหน้าแรก
        </a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  // Retrieve the generated event ID from sessionStorage to show to the user and log
  const eventId = sessionStorage.getItem('last_lead_event_id');
  const refElement = document.getElementById('leadRefId');
  if (eventId) {
    refElement.textContent = eventId;
    
    // Fallback: If for any reason the dataLayer push failed on the previous page,
    // we can fire a backup or log here.
    console.log('Lead conversion success with event_id:', eventId);
  } else {
    refElement.textContent = 'N/A';
  }
</script>
