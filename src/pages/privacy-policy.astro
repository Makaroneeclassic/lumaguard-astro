---
import Layout from '../layouts/Layout.astro';
import TopNavBar from '@/components/TopNavBar.astro';
import Footer from '@/components/Footer';
import JsonLd from '@/components/JsonLd.astro';
import { buildBreadcrumbSchema } from '@/lib/schema';
import { BUSINESS } from '@/lib/site';
import { getPageSeo } from '@/lib/pageSeo';

const seo = await getPageSeo('/privacy-policy', {
  title: 'นโยบายความเป็นส่วนตัว | LUMAGUARD',
  description:
    'นโยบายความเป็นส่วนตัวของ LUMAGUARD อธิบายว่าเราเก็บข้อมูลอะไรบ้าง นำไปใช้ทำอะไร เก็บไว้นานเท่าใด และคุณมีสิทธิอะไรตามพระราชบัญญัติคุ้มครองข้อมูลส่วนบุคคล',
});
const { title, description } = seo;

// ทบทวนล่าสุดเมื่อใด ต้องอัปเดตทุกครั้งที่แก้เนื้อหาในหน้านี้
const lastUpdated = '2026-08-19';
const dateText = new Intl.DateTimeFormat('th-TH', { dateStyle: 'long' }).format(new Date(lastUpdated));

const rights = [
  ['สิทธิขอเข้าถึงข้อมูล', 'ขอดูข้อมูลส่วนบุคคลของคุณที่เราเก็บไว้ และขอสำเนาได้'],
  ['สิทธิขอแก้ไขข้อมูล', 'ขอให้แก้ไขข้อมูลที่ไม่ถูกต้องหรือไม่เป็นปัจจุบัน'],
  ['สิทธิขอลบข้อมูล', 'ขอให้ลบข้อมูลเมื่อหมดความจำเป็นหรือเมื่อคุณถอนความยินยอม'],
  ['สิทธิขอระงับการใช้ข้อมูล', 'ขอให้หยุดใช้ข้อมูลชั่วคราวระหว่างตรวจสอบความถูกต้อง'],
  ['สิทธิคัดค้านการประมวลผล', 'คัดค้านการใช้ข้อมูลเพื่อการตลาดหรือการวิเคราะห์ได้ทุกเมื่อ'],
  ['สิทธิขอให้โอนย้ายข้อมูล', 'ขอรับข้อมูลในรูปแบบที่อ่านได้ด้วยเครื่อง หรือให้ส่งต่อไปยังผู้ควบคุมข้อมูลรายอื่น'],
  ['สิทธิถอนความยินยอม', 'ถอนความยินยอมที่เคยให้ไว้ได้ตลอดเวลา โดยไม่กระทบการประมวลผลที่ทำไปแล้ว'],
  ['สิทธิร้องเรียน', 'ร้องเรียนต่อสำนักงานคณะกรรมการคุ้มครองข้อมูลส่วนบุคคลได้ หากเห็นว่าเราทำไม่ถูกต้อง'],
];
---

<Layout title={title} description={description}>
  <JsonLd
    schema={buildBreadcrumbSchema([
      { name: 'หน้าแรก', url: '/' },
      { name: 'นโยบายความเป็นส่วนตัว', url: '/privacy-policy' },
    ])}
  />

  <TopNavBar pathname={Astro.url.pathname} />

  <main class="min-h-screen pt-28 pb-20 px-6">
    <article class="mx-auto max-w-3xl">
      <nav aria-label="breadcrumb" class="mb-6 text-sm text-on-surface-variant">
        <a href="/" class="hover:text-primary transition-colors">หน้าแรก</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-on-surface-variant/60">นโยบายความเป็นส่วนตัว</span>
      </nav>

      <h1 class="text-3xl md:text-4xl font-black text-on-surface tracking-tight">
        นโยบายความเป็นส่วนตัว
      </h1>
      <p class="mt-3 text-sm text-on-surface-variant">
        ปรับปรุงล่าสุด <time datetime={lastUpdated}>{dateText}</time>
      </p>

      <div class="prose prose-slate max-w-none mt-10 prose-headings:font-headline prose-headings:text-on-surface prose-a:text-primary">
        <p>
          {BUSINESS.legalName} ("เรา") เคารพความเป็นส่วนตัวของผู้ใช้บริการทุกท่าน
          นโยบายฉบับนี้อธิบายว่าเราเก็บข้อมูลส่วนบุคคลอะไรบ้าง นำไปใช้ทำอะไร
          เปิดเผยให้ใคร เก็บไว้นานเท่าใด และคุณมีสิทธิอะไรบ้าง
          ตามพระราชบัญญัติคุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562
        </p>

        <h2>1. ผู้ควบคุมข้อมูลส่วนบุคคล</h2>
        <p>
          {BUSINESS.legalName}<br />
          {BUSINESS.address.addressLocality} {BUSINESS.address.addressRegion} {BUSINESS.address.postalCode}<br />
          โทรศัพท์ <a href={`tel:${BUSINESS.telephone}`}>{BUSINESS.telephoneDisplay}</a><br />
          LINE Official Account {BUSINESS.lineOfficialAccount}
        </p>

        <h2>2. ข้อมูลที่เราเก็บ</h2>
        <h3>2.1 ข้อมูลที่คุณให้เราโดยตรง</h3>
        <p>เมื่อคุณกรอกแบบฟอร์มขอใบเสนอราคาหรือติดต่อเรา เราจะเก็บ</p>
        <ul>
          <li>ชื่อ-นามสกุล</li>
          <li>หมายเลขโทรศัพท์</li>
          <li>เขตหรืออำเภอที่ตั้งของอาคาร</li>
          <li>ประเภทสิ่งปลูกสร้างและพื้นที่กระจกโดยประมาณ</li>
        </ul>

        <h3>2.2 ข้อมูลที่เก็บโดยอัตโนมัติ</h3>
        <p>
          เมื่อคุณเข้าชมเว็บไซต์ ระบบจะบันทึกหมายเลขไอพี ชนิดของเบราว์เซอร์และอุปกรณ์
          หน้าที่เข้าชม เวลาที่เข้าชม และแหล่งที่มาของการเข้าชม เช่น คำค้นหาหรือโฆษณาที่คุณคลิกมา
        </p>
        <p>
          ข้อมูลเพื่อการวิเคราะห์และการตลาดจะเก็บ<strong>ต่อเมื่อคุณกดยอมรับคุกกี้</strong>เท่านั้น
          หากคุณปฏิเสธ เราจะเก็บเฉพาะข้อมูลที่จำเป็นต่อการทำงานของเว็บไซต์
        </p>

        <h2>3. วัตถุประสงค์และฐานทางกฎหมาย</h2>
        <table>
          <thead>
            <tr><th>วัตถุประสงค์</th><th>ฐานทางกฎหมาย</th></tr>
          </thead>
          <tbody>
            <tr><td>ติดต่อกลับเพื่อเสนอราคาและนัดหมายสำรวจหน้างาน</td><td>ความยินยอม และการดำเนินการตามคำขอก่อนเข้าทำสัญญา</td></tr>
            <tr><td>ให้บริการติดตั้งและบริการหลังการขาย</td><td>การปฏิบัติตามสัญญา</td></tr>
            <tr><td>วิเคราะห์การใช้งานเว็บไซต์เพื่อปรับปรุงบริการ</td><td>ความยินยอม</td></tr>
            <tr><td>วัดผลโฆษณาและการตลาด</td><td>ความยินยอม</td></tr>
            <tr><td>เก็บหลักฐานทางบัญชีและภาษี</td><td>การปฏิบัติตามกฎหมาย</td></tr>
          </tbody>
        </table>

        <h2>4. การเปิดเผยข้อมูลต่อบุคคลภายนอก</h2>
        <p>
          เรา<strong>ไม่ขายและไม่ให้เช่า</strong>ข้อมูลส่วนบุคคลของคุณ
          แต่มีผู้ให้บริการที่จำเป็นต่อการดำเนินงานซึ่งอาจเข้าถึงข้อมูลบางส่วน
        </p>
        <ul>
          <li>ผู้ให้บริการโครงสร้างพื้นฐานเว็บไซต์และฐานข้อมูล สำหรับจัดเก็บข้อมูล</li>
          <li>ผู้ให้บริการวิเคราะห์เว็บไซต์และโฆษณา สำหรับวัดผลการตลาด เฉพาะเมื่อคุณยินยอม</li>
          <li>ผู้ให้บริการส่งข้อความและอีเมล สำหรับแจ้งเตือนทีมงานเมื่อคุณติดต่อเข้ามา</li>
        </ul>
        <p>
          ผู้ให้บริการบางรายมีเซิร์ฟเวอร์อยู่ต่างประเทศ
          การส่งข้อมูลออกนอกราชอาณาจักรจะทำภายใต้มาตรการคุ้มครองที่เหมาะสมตามที่กฎหมายกำหนด
        </p>

        <h2>5. ระยะเวลาเก็บรักษา</h2>
        <ul>
          <li>ข้อมูลผู้สนใจที่ยังไม่ได้เป็นลูกค้า เก็บไม่เกิน 2 ปีนับจากการติดต่อครั้งล่าสุด</li>
          <li>ข้อมูลลูกค้าที่ใช้บริการแล้ว เก็บตลอดระยะเวลารับประกัน และต่อไปอีก 1 ปีหลังสิ้นสุดการรับประกัน เพื่อรองรับการเคลม</li>
          <li>เอกสารทางบัญชีและภาษี เก็บตามที่กฎหมายกำหนด</li>
          <li>ข้อมูลการวิเคราะห์เว็บไซต์ เก็บไม่เกิน 14 เดือน</li>
        </ul>
        <p>เมื่อพ้นกำหนด เราจะลบหรือทำให้ข้อมูลไม่สามารถระบุตัวบุคคลได้</p>

        <h2>6. สิทธิของคุณ</h2>
        <p>ในฐานะเจ้าของข้อมูลส่วนบุคคล คุณมีสิทธิดังนี้</p>
        <ul>
          {rights.map(([name, detail]) => (
            <li><strong>{name}</strong> — {detail}</li>
          ))}
        </ul>
        <p>
          หากต้องการใช้สิทธิ กรุณาติดต่อเราตามช่องทางในข้อ 9
          เราจะดำเนินการภายใน 30 วันนับจากวันที่ได้รับคำขอ
        </p>

        <h2>7. คุกกี้</h2>
        <p>เราใช้คุกกี้สองประเภท</p>
        <ul>
          <li><strong>คุกกี้ที่จำเป็น</strong> ทำให้เว็บไซต์ทำงานได้ตามปกติ เช่น การจดจำการตั้งค่าความยินยอมของคุณ ไม่สามารถปิดได้</li>
          <li><strong>คุกกี้เพื่อการวิเคราะห์และการตลาด</strong> ช่วยให้เราเข้าใจว่าผู้ใช้เข้าถึงเว็บไซต์อย่างไร ใช้ต่อเมื่อคุณกดยอมรับ</li>
        </ul>
        <p>
          คุณเปลี่ยนการตั้งค่าได้ตลอดเวลาโดยล้างข้อมูลเว็บไซต์ในเบราว์เซอร์
          แล้วเลือกใหม่เมื่อแบนเนอร์ปรากฏขึ้นอีกครั้ง
        </p>

        <h2>8. ความปลอดภัยของข้อมูล</h2>
        <p>
          เราเข้ารหัสการรับส่งข้อมูลทั้งหมดด้วย HTTPS จำกัดสิทธิ์การเข้าถึงระบบหลังบ้าน
          เฉพาะผู้ที่จำเป็น และเก็บรหัสผ่านในรูปแบบที่ถอดกลับไม่ได้
          อย่างไรก็ตาม ไม่มีระบบใดปลอดภัยสมบูรณ์
          หากเกิดเหตุละเมิดข้อมูลที่มีความเสี่ยงสูง เราจะแจ้งให้คุณและหน่วยงานที่เกี่ยวข้องทราบตามที่กฎหมายกำหนด
        </p>

        <h2>9. ติดต่อเรา</h2>
        <p>
          หากมีคำถามเกี่ยวกับนโยบายนี้ หรือต้องการใช้สิทธิของเจ้าของข้อมูล ติดต่อได้ที่<br />
          โทรศัพท์ <a href={`tel:${BUSINESS.telephone}`}>{BUSINESS.telephoneDisplay}</a><br />
          LINE Official Account {BUSINESS.lineOfficialAccount}
        </p>
        <p>
          หากคุณเห็นว่าเราประมวลผลข้อมูลไม่ถูกต้องตามกฎหมาย
          คุณมีสิทธิร้องเรียนต่อสำนักงานคณะกรรมการคุ้มครองข้อมูลส่วนบุคคล
        </p>

        <h2>10. การเปลี่ยนแปลงนโยบาย</h2>
        <p>
          เราอาจปรับปรุงนโยบายนี้เป็นครั้งคราว
          หากมีการเปลี่ยนแปลงในสาระสำคัญ เราจะแจ้งให้ทราบผ่านเว็บไซต์
          วันที่ปรับปรุงล่าสุดแสดงไว้ด้านบนของหน้านี้
        </p>
      </div>
    </article>
  </main>

  <Footer client:visible />
</Layout>
