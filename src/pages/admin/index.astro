---
import Layout from '../../layouts/Layout.astro';
import AdminDashboard from '@/components/admin/AdminDashboard';
import { prisma } from '@/lib/db';
import { getCollection } from 'astro:content';

export const prerender = false;

let leads: any[] = [];
let dbError = false;

const stats = { leadsNew: 0, leadsTotal: 0, posts: 0, products: 0, portfolio: 0 };

// บทความอยู่ใน git เป็น MDX แล้ว ไม่ได้อยู่ใน DB — นับจาก content collection
// ครอบ try ไว้เพราะหน้านี้เรนเดอร์ตอนมีรีเควสต์ ถ้าอ่านคอลเลกชันพลาด
// ทั้งหน้าจะกลายเป็น 500 หน้าขาวทั้งที่แค่ตัวเลขสถิติตัวเดียวหาย
try {
  stats.posts = (await getCollection('blog', ({ data }) => !data.draft)).length;
} catch (e) {
  console.error('[admin] นับจำนวนบทความไม่สำเร็จ:', e);
}

try {
  const [leadList, leadsNew, products, portfolio] = await Promise.all([
    prisma.lead.findMany({ orderBy: { createdAt: 'desc' } }),
    prisma.lead.count({ where: { status: 'new' } }),
    prisma.product.count(),
    prisma.portfolioItem.count(),
  ]);
  leads = leadList;
  stats.leadsTotal = leadList.length;
  stats.leadsNew = leadsNew;
  stats.products = products;
  stats.portfolio = portfolio;
} catch (e) {
  dbError = true;
  console.error("Database connection failed while fetching admin dashboard data.");
}
---

<Layout
  title="Admin Dashboard | LUMAGUARD"
  description="LUMAGUARD Admin Dashboard"
  noindex={true}
>
  <div class="min-h-screen bg-slate-900 text-slate-100 p-8 space-y-8">
    <div class="max-w-[1440px] mx-auto space-y-8">
      <div class="flex items-center justify-between border-b border-slate-800 pb-6">
        <div>
          <h1 class="text-3xl font-bold text-white tracking-tight">LUMAGUARD Admin Portal</h1>
          <p class="text-slate-400 text-sm mt-1">จัดการภาพรวมระบบ ข้อมูล Lead รายชื่อสินค้า บทความ และงานติดตั้ง</p>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-slate-400 text-sm hidden md:inline">{Astro.locals.session?.email}</span>
          <a href="/" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-4 py-2 rounded-lg text-sm transition-all border border-slate-700">
            ← กลับหน้าเว็บไซต์
          </a>
          <form method="POST" action="/api/auth/logout">
            <button type="submit" class="bg-slate-800 hover:bg-red-600/80 text-slate-200 px-4 py-2 rounded-lg text-sm transition-all border border-slate-700">
              ออกจากระบบ
            </button>
          </form>
        </div>
      </div>

      <AdminDashboard client:load stats={stats} leads={leads} dbError={dbError} />
    </div>
  </div>
</Layout>
