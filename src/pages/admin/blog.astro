---
import Layout from '../../layouts/Layout.astro';
import BlogWriter from '@/components/admin/blogwriter/BlogWriter';

/**
 * เครื่องมือเขียนบทความด้วย AI — ย้ายมาจาก Chrome extension "Smart Bot Writer"
 *
 * middleware คุ้มเส้นทาง /admin ทั้งหมดแล้ว หน้านี้แค่ต้องเป็น SSR
 * เพื่อให้ middleware ได้ทำงาน (หน้า static จะถูกเสิร์ฟข้าม middleware)
 */
export const prerender = false;
---

<Layout
  title="เขียนบทความ | LUMAGUARD Admin"
  description="LUMAGUARD AI Blog Writer"
  noindex={true}
>
  <div class="min-h-screen bg-slate-900 text-slate-100 p-4 md:p-8">
    <div class="max-w-3xl mx-auto space-y-8">
      <div class="flex items-center justify-between border-b border-slate-800 pb-6">
        <div>
          <img
            src="/logo-white.webp"
            alt="LUMAGUARD"
            width="600"
            height="146"
            class="h-7 w-auto"
            decoding="async"
          />
          <h1 class="text-2xl font-bold text-white tracking-tight mt-3">เขียนบทความด้วย AI</h1>
          <p class="text-slate-400 text-sm mt-1">
            เลือกหัวข้อจาก Topical Map → Generate → ตรวจ → บันทึกขึ้นเว็บได้ทันที
          </p>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-slate-400 text-sm hidden md:inline">{Astro.locals.session?.email}</span>
          <a href="/admin" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-4 py-2 rounded-lg text-sm transition-all border border-slate-700">
            ← Dashboard
          </a>
        </div>
      </div>

      <BlogWriter client:load />
    </div>
  </div>
</Layout>
