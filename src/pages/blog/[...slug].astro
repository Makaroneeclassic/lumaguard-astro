---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TopNavBar from '@/components/TopNavBar';
import Footer from '@/components/Footer';
import LeadForm from '@/components/LeadForm';
import JsonLd from '@/components/JsonLd.astro';
import ArticleCta from '@/components/blog/ArticleCta.astro';
import FaqSection from '@/components/blog/FaqSection.astro';
import { getPublishedPosts, getRelatedPosts } from '@/lib/blog';
import { buildArticleSchema, buildBreadcrumbSchema, buildFaqSchema } from '@/lib/schema';
import { absoluteUrl } from '@/lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);

const related = getRelatedPosts(post, posts);
const canonical = absoluteUrl(`/blog/${post.id}`);

const breadcrumb = [
  { name: 'หน้าแรก', url: '/' },
  { name: 'บทความ', url: '/blog' },
  { name: post.data.title, url: `/blog/${post.id}` },
];

const articleSchema = buildArticleSchema({
  title: post.data.title,
  description: post.data.description,
  canonical,
  image: post.data.heroImage ? absoluteUrl(post.data.heroImage) : undefined,
  author: post.data.author,
  publishedAt: post.data.pubDate,
  modifiedAt: post.data.updatedDate,
});

const dateFormatter = new Intl.DateTimeFormat('th-TH', { dateStyle: 'long' });
---

<Layout
  title={`${post.data.title} | LUMAGUARD`}
  description={post.data.description}
  type="article"
  image={post.data.heroImage}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate ?? post.data.pubDate}
  noindex={post.data.noindex}
>
  <JsonLd schema={articleSchema} />
  <JsonLd schema={buildBreadcrumbSchema(breadcrumb)} />
  {post.data.faq && post.data.faq.length > 0 && <JsonLd schema={buildFaqSchema(post.data.faq)} />}

  <TopNavBar client:idle />

  <article class="min-h-screen pt-24 pb-16 px-6 max-w-3xl mx-auto">
    <nav aria-label="breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
        {breadcrumb.slice(0, -1).map((crumb) => (
          <li class="flex items-center gap-2">
            <a href={crumb.url} class="hover:text-accent-600 transition-colors">{crumb.name}</a>
            <span aria-hidden="true">/</span>
          </li>
        ))}
        <li aria-current="page" class="text-slate-400 truncate max-w-[16rem]">{post.data.title}</li>
      </ol>
    </nav>

    <header class="space-y-4">
      <h1 class="text-3xl md:text-4xl font-black text-slate-900 leading-tight">
        {post.data.title}
      </h1>
      <p class="text-slate-500 text-sm">
        {post.data.author}
        <span aria-hidden="true"> • </span>
        <time datetime={post.data.pubDate.toISOString()}>
          {dateFormatter.format(post.data.pubDate)}
        </time>
        {post.data.updatedDate && (
          <span> • อัปเดต {dateFormatter.format(post.data.updatedDate)}</span>
        )}
      </p>
    </header>

    {post.data.heroImage && (
      <img
        src={post.data.heroImage}
        alt={post.data.heroAlt ?? ''}
        width={post.data.heroWidth}
        height={post.data.heroHeight}
        fetchpriority="high"
        decoding="async"
        class="mt-8 w-full rounded-2xl border border-slate-200 shadow-sm"
      />
    )}

    <div class="prose prose-lg prose-slate max-w-none mt-8">
      <Content components={{ ArticleCta }} />
    </div>

    {post.data.faq && <FaqSection faq={post.data.faq} />}


    {related.length > 0 && (
      <section class="mt-16 pt-10 border-t border-slate-200 space-y-6">
        <h2 class="text-2xl font-bold text-slate-900">บทความที่เกี่ยวข้อง</h2>
        <ul class="grid gap-4 sm:grid-cols-2">
          {related.map((item) => (
            <li>
              <a
                href={`/blog/${item.id}`}
                class="block h-full rounded-xl border border-slate-200 p-5 transition-shadow hover:shadow-md"
              >
                <h3 class="font-bold text-slate-900 leading-snug">{item.data.title}</h3>
                <p class="mt-2 text-sm text-slate-600 line-clamp-2">{item.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="pt-16 border-t border-slate-200 mt-16">
      <LeadForm client:visible tone="sky" />
    </div>
  </article>

  <Footer client:visible />
</Layout>
