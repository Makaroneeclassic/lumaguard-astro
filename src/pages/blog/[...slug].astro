---
import Layout from '../../layouts/Layout.astro';
import TopNavBar from '@/components/TopNavBar';
import Footer from '@/components/Footer';
import LeadForm from '@/components/LeadForm';
import JsonLd from '@/components/JsonLd.astro';
import { prisma } from '@/lib/db';

export async function getStaticPaths() {
  let posts: any[] = [];
  try {
    posts = await prisma.blogPost.findMany({
      where: { published: true }
    });
  } catch (e) {
    console.warn("DB connection for getStaticPaths fallback");
  }

  if (posts.length === 0) {
    return [
      { params: { slug: 'keep-home-cooler-nano-ceramic-film' } },
      { params: { slug: 'architectural-vs-automotive-window-film' } },
      { params: { slug: 'first-post' } }
    ];
  }

  return posts.map((post) => ({
    params: { slug: post.slug }
  }));
}

const { slug } = Astro.params;

let post: any = null;
try {
  post = await prisma.blogPost.findUnique({
    where: { slug: slug || '' },
  });
} catch (e) {
  console.warn("DB query failed for blog post slug:", slug);
}

if (!post) {
  post = {
    title: "วิธีลดอุณหภูมิบ้านลงสูงสุด 12°C ช่วงหน้าร้อนด้วยฟิล์มนาโนเซรามิก",
    slug: slug || "keep-home-cooler-nano-ceramic-film",
    excerpt: "เจาะลึกวิทยาศาสตร์เบื้องหลังฟิล์มนาโนเซรามิกระดับพรีเมียม วิธีลดอุณหภูมิห้องลงอย่างเห็นได้ชัดและประหยัดค่าไฟทันที",
    content: "<p>การเลือกติดตั้งฟิล์มกรองแสงอาคาร นาโนเซรามิกพรีเมียม ช่วยตัดรังสีความร้อนอินฟราเรดได้สูงสุดถึง 98% โดยไม่บดบังทัศนียภาพที่สว่างใสจากภายในบ้าน...</p>",
    coverImage: "https://lh3.googleusercontent.com/aida-public/AB6AXuCtRl__yxJ6Fs5rzjxxFoGNYt8SZbMncfyQnx5m7KHY06IiClHr1HazLSVAa8Tzutg4o0HZ4mdHZxnycwarQMVSHeOGVnpDM8xb6JV4avzMJSaTyEZzeNfgjZWzSV12AG3A0eC3tFT4vUJgCFx01YEBg98SznHzSVzN-vFzde3NPFzGbcvKsVBx_FW6x6L8DtNKake2QrT6PGShJQ1_2dsw76aR20Y2GFh037q-TxD5iXPJuUZbiXTVj4QtcLCRYn_ykcacTzLVFiDN",
    category: "Energy Efficiency",
    readingTime: "8 min read",
    authorName: "ทีมงานวิศวกร LUMAGUARD",
    createdAt: new Date(),
  };
}

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "image": [post.coverImage],
  "author": {
    "@type": "Person",
    "name": post.authorName || "LUMAGUARD Team"
  },
  "publisher": {
    "@type": "Organization",
    "name": "LUMAGUARD",
    "logo": {
      "@type": "ImageObject",
      "url": "https://lumaguard.com/logo.png"
    }
  }
};
---

<Layout title={`${post.title} | LUMAGUARD`} description={post.excerpt}>
  <JsonLd schema={articleSchema} />
  <TopNavBar client:load />

  <article class="min-h-screen pt-24 pb-16 px-6 max-w-4xl mx-auto space-y-8">
    <div class="space-y-4 text-center">
      <span class="inline-block px-3 py-1 bg-sky-100 text-sky-700 font-semibold text-xs rounded-full">
        {post.category}
      </span>
      <h1 class="text-3xl md:text-5xl font-black text-slate-900 leading-tight">
        {post.title}
      </h1>
      <p class="text-slate-500 text-sm">
        {post.authorName} • {post.readingTime}
      </p>
    </div>

    {post.coverImage && (
      <div class="rounded-2xl overflow-hidden shadow-lg border border-slate-200">
        <img src={post.coverImage} alt={post.title} class="w-full h-[400px] object-cover" />
      </div>
    )}

    <div class="prose prose-lg max-w-none text-slate-700 leading-relaxed font-light space-y-6" set:html={post.content} />

    <div class="pt-16 border-t border-slate-200">
      <LeadForm client:visible />
    </div>
  </article>

  <Footer client:visible />
</Layout>
