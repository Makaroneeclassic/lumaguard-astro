---
import Layout from '../../layouts/Layout.astro';
import TopNavBar from '@/components/TopNavBar';
import Footer from '@/components/Footer';
import JsonLd from '@/components/JsonLd.astro';
import { getPublishedPosts } from '@/lib/blog';
import { buildBreadcrumbSchema } from '@/lib/schema';

import { getPageSeo } from '@/lib/pageSeo';
const posts = await getPublishedPosts();

const seo = await getPageSeo('/blog', {
  title: 'บทความน่ารู้เกี่ยวกับฟิล์มกรองแสงอาคาร บ้าน และคอนโด | LUMAGUARD',
  description: 'รวมคู่มือเลือกฟิล์มกรองแสงอาคาร วิธีลดอุณหภูมิห้อง เทคนิคประหยัดค่าไฟ ฟิล์มนิรภัย และความรู้เรื่องฟิล์มนาโนเซรามิกจากทีมวิศวกร LUMAGUARD',
});
const { title, description } = seo;
const dateFormatter = new Intl.DateTimeFormat('th-TH', { dateStyle: 'medium' });
---

<Layout title={title} description={description}>
  <JsonLd
    schema={buildBreadcrumbSchema([
      { name: 'หน้าแรก', url: '/' },
      { name: 'บทความ', url: '/blog' },
    ])}
  />

  <TopNavBar client:idle />

  <main class="min-h-screen pt-24 pb-16 px-6 max-w-[1200px] mx-auto space-y-12">
    <header class="text-center max-w-3xl mx-auto space-y-4">
      <h1 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight">
        บทความ &amp; คู่มือเลือกฟิล์มกรองแสง
      </h1>
      <p class="text-slate-600 leading-relaxed">
        สาระน่ารู้เรื่องฟิล์มกรองแสงอาคาร นวัตกรรมนาโนเซรามิก การประหยัดพลังงาน
        และเทคนิคดูแลกระจกบ้าน จากทีมวิศวกรของเรา
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="text-center text-slate-500 py-16">ยังไม่มีบทความเผยแพร่ในขณะนี้</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post, index) => (
            <article class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col">
              {post.data.heroImage && (
                <a href={`/blog/${post.id}`} class="block overflow-hidden">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.heroAlt ?? ''}
                    width={post.data.heroWidth}
                    height={post.data.heroHeight}
                    loading={index < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="h-48 w-full object-cover hover:scale-105 transition-transform duration-300"
                  />
                </a>
              )}
              <div class="p-6 flex-1 flex flex-col justify-between gap-4">
                <div class="space-y-3">
                  <h2 class="text-xl font-bold text-slate-900 leading-snug">
                    <a href={`/blog/${post.id}`} class="hover:text-accent-600 transition-colors">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="text-slate-600 text-sm line-clamp-3 leading-relaxed">
                    {post.data.description}
                  </p>
                </div>

                <div class="flex items-center justify-between text-xs text-slate-400 pt-4 border-t border-slate-100">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {dateFormatter.format(post.data.pubDate)}
                  </time>
                  <a href={`/blog/${post.id}`} class="text-accent-600 font-bold hover:underline">
                    อ่านต่อ →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </main>

  <Footer client:visible />
</Layout>
